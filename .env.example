# ---------------------------------------------------------------- Kiln settings
# Copy to .env and fill in. Generate secrets with:  kiln generate-secrets
#   (or: docker compose run --rm --no-deps -e KILN_SKIP_MIGRATIONS=1 kiln kiln generate-secrets)

KILN_ENV=production
# Public URL people use to reach Kiln. Must match the GitHub OAuth callback URL.
KILN_BASE_URL=http://localhost:8000

KILN_SECRET_KEY=change-me-to-48-random-characters
# Fernet key for encrypting SSH keys, passwords, env vars and GitHub tokens at rest. Back it up.
# To rotate: KILN_ENCRYPTION_KEY=new,old, restart, run `kiln rotate-encryption-key`, then drop the old key.
# Secrets encrypted with a lost key read as empty and must be re-entered.
KILN_ENCRYPTION_KEY=

# Postgres password used by docker-compose. It is passed to Kiln as KILN_DATABASE_PASSWORD,
# so any character is fine.
POSTGRES_PASSWORD=change-me
# Outside docker-compose, point Kiln at Postgres directly:
# KILN_DATABASE_URL=postgresql+asyncpg://kiln@localhost:5432/kiln
# KILN_DATABASE_PASSWORD=...   (used unless the URL contains its own password)

# ------------------------------------------------------------------ first admin
# Created on startup only if there are no users yet. Remove after first start.
# While KILN_ADMIN_EMAIL is set and there are no users, GitHub sign-in and self-registration cannot create the
# first account. The password must be at least 10 characters; if it is missing or too short Kiln logs an error
# and creates no admin.
KILN_ADMIN_EMAIL=
KILN_ADMIN_PASSWORD=

# --------------------------------------------------------------------- accounts
# Allow anyone to register with email/password (POST /api/v1/auth/register).
KILN_ALLOW_SIGNUP=false
# Role given to new accounts (admin, maintainer, developer, viewer or a custom role).
# It cannot be deleted while it is the default; if it does not exist, Kiln logs an error and sign-ups fail.
KILN_DEFAULT_ROLE=viewer

# ----------------------------------------------------------------------- GitHub
# Create an OAuth App: https://github.com/settings/developers
#   Homepage URL:               same as KILN_BASE_URL
#   Authorization callback URL: <KILN_BASE_URL>/auth/github/callback
KILN_GITHUB_CLIENT_ID=
KILN_GITHUB_CLIENT_SECRET=
# GitHub users / orgs allowed to create a Kiln account by signing in with GitHub.
# Entries are names or immutable ids written as id:<number> (e.g. alice,id:583231). Names can be
# re-registered by someone else after a rename, so prefer ids.
# Existing users can always link GitHub from Settings. With no allowlist set (and KILN_ADMIN_EMAIL unset),
# the very first user to sign in becomes admin; with one set, only an allow-listed user can be that first admin.
KILN_GITHUB_ALLOWED_USERS=
KILN_GITHUB_ALLOWED_ORGS=
# Optional token used for deploys triggered by users who haven't linked GitHub.
KILN_GITHUB_SERVICE_TOKEN=

# ------------------------------------------------------------------------ hosts
# Seconds between background health checks of verified hosts (0 disables).
KILN_HOST_POLL_INTERVAL=300

# ------------------------------------------------------------------- networking
# Reverse proxy IP(s)/CIDR(s) allowed to set X-Forwarded-For, as seen from inside the container
# (e.g. the Docker network gateway 172.18.0.1). Keep 127.0.0.1 without a proxy. Behind a proxy, leaving
# the default makes every client share the proxy's IP for rate limiting. Never use *.
KILN_FORWARDED_ALLOW_IPS=127.0.0.1
# DEBUG, INFO, WARNING, ERROR or CRITICAL (any case).
KILN_LOG_LEVEL=INFO
