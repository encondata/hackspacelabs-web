# ---------------------------------------------------------------- Kiln settings
# Copy to .env and fill in. Generate secrets with:  kiln generate-secrets
#   (or: docker compose run --rm --no-deps -e KILN_SKIP_MIGRATIONS=1 kiln kiln generate-secrets)

KILN_ENV=production
# Public URL people use to reach Kiln. Must match the GitHub OAuth callback URL.
KILN_BASE_URL=http://localhost:8000

KILN_SECRET_KEY=change-me-to-48-random-characters
# Fernet key for encrypting SSH keys, passwords, env vars and GitHub tokens at rest.
# Comma-separate keys to rotate (first one encrypts). Losing it means re-entering secrets.
KILN_ENCRYPTION_KEY=

# Postgres password used by docker-compose (KILN_DATABASE_URL is set there).
POSTGRES_PASSWORD=change-me
# Outside docker-compose, point Kiln at Postgres directly:
# KILN_DATABASE_URL=postgresql+asyncpg://kiln:password@localhost:5432/kiln

# ------------------------------------------------------------------ first admin
# Created on startup only if there are no users yet. Remove after first start.
KILN_ADMIN_EMAIL=
KILN_ADMIN_PASSWORD=

# --------------------------------------------------------------------- accounts
# Allow anyone to register with email/password (POST /api/v1/auth/register).
KILN_ALLOW_SIGNUP=false
# Role given to new accounts (admin, maintainer, developer, viewer or a custom role).
KILN_DEFAULT_ROLE=viewer

# ----------------------------------------------------------------------- GitHub
# Create an OAuth App: https://github.com/settings/developers
#   Homepage URL:               same as KILN_BASE_URL
#   Authorization callback URL: <KILN_BASE_URL>/auth/github/callback
KILN_GITHUB_CLIENT_ID=
KILN_GITHUB_CLIENT_SECRET=
# GitHub users / orgs allowed to create a Kiln account by signing in with GitHub.
# (Existing users can always link GitHub from Settings. The very first user becomes admin.)
KILN_GITHUB_ALLOWED_USERS=
KILN_GITHUB_ALLOWED_ORGS=
# Optional token used for deploys triggered by users who haven't linked GitHub.
KILN_GITHUB_SERVICE_TOKEN=

# ------------------------------------------------------------------------ hosts
# Seconds between background health checks of verified hosts (0 disables).
KILN_HOST_POLL_INTERVAL=300
