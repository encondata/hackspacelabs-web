# ------------------------------------------------------------- Slipway settings
# Copy to .env and fill in. Generate secrets with:  slipway generate-secrets
#   (or: docker compose run --rm --no-deps -e SLIPWAY_SKIP_MIGRATIONS=1 slipway slipway generate-secrets)

SLIPWAY_ENV=production
# Public URL people use to reach Slipway. Must match the GitHub OAuth callback URL.
SLIPWAY_BASE_URL=http://localhost:8000

SLIPWAY_SECRET_KEY=change-me-to-48-random-characters
# Fernet key for encrypting SSH keys, passwords, env vars and GitHub tokens at rest. Back it up.
# To rotate: SLIPWAY_ENCRYPTION_KEY=new,old, restart, run `slipway rotate-encryption-key`, then drop the old key.
# Secrets encrypted with a lost key read as empty and must be re-entered.
SLIPWAY_ENCRYPTION_KEY=

# Postgres password used by docker-compose. It is passed to Slipway as SLIPWAY_DATABASE_PASSWORD,
# so any character is fine.
POSTGRES_PASSWORD=change-me
# Outside docker-compose, point Slipway at Postgres directly:
# SLIPWAY_DATABASE_URL=postgresql+asyncpg://slipway@localhost:5432/slipway
# SLIPWAY_DATABASE_PASSWORD=...   (used unless the URL contains its own password)

# ------------------------------------------------------------------ first admin
# Created on startup only if there are no users yet. Remove after first start.
# While SLIPWAY_ADMIN_EMAIL is set and there are no users, GitHub sign-in and self-registration cannot create the
# first account. The password must be at least 10 characters; if it is missing or too short Slipway logs an error
# and creates no admin.
SLIPWAY_ADMIN_EMAIL=
SLIPWAY_ADMIN_PASSWORD=

# --------------------------------------------------------------------- accounts
# Allow anyone to register with email/password (POST /api/v1/auth/register).
SLIPWAY_ALLOW_SIGNUP=false
# Role given to new accounts (admin, maintainer, developer, viewer or a custom role).
# It cannot be deleted while it is the default; if it does not exist, Slipway logs an error and sign-ups fail.
SLIPWAY_DEFAULT_ROLE=viewer

# ----------------------------------------------------------------------- GitHub
# Create an OAuth App: https://github.com/settings/developers
#   Homepage URL:               same as SLIPWAY_BASE_URL
#   Authorization callback URL: <SLIPWAY_BASE_URL>/auth/github/callback
SLIPWAY_GITHUB_CLIENT_ID=
SLIPWAY_GITHUB_CLIENT_SECRET=
# GitHub users / orgs allowed to create a Slipway account by signing in with GitHub.
# Entries are names or immutable ids written as id:<number> (e.g. alice,id:583231). Names can be
# re-registered by someone else after a rename, so prefer ids.
# Existing users can always link GitHub from Settings. With no allowlist set (and SLIPWAY_ADMIN_EMAIL unset),
# the very first user to sign in becomes admin; with one set, only an allow-listed user can be that first admin.
SLIPWAY_GITHUB_ALLOWED_USERS=
SLIPWAY_GITHUB_ALLOWED_ORGS=
# Optional token used for deploys triggered by users who haven't linked GitHub.
SLIPWAY_GITHUB_SERVICE_TOKEN=

# ------------------------------------------------------------------------ hosts
# Seconds between background health checks of verified hosts (0 disables).
SLIPWAY_HOST_POLL_INTERVAL=300

# ------------------------------------------------------------------- networking
# Reverse proxy IP(s)/CIDR(s) allowed to set X-Forwarded-For, as seen from inside the container
# (e.g. the Docker network gateway 172.18.0.1). Keep 127.0.0.1 without a proxy. Behind a proxy, leaving
# the default makes every client share the proxy's IP for rate limiting. Never use *.
SLIPWAY_FORWARDED_ALLOW_IPS=127.0.0.1
# DEBUG, INFO, WARNING, ERROR or CRITICAL (any case).
SLIPWAY_LOG_LEVEL=INFO
