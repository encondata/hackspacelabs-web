# Generate a private .env with: node scripts/init-env.mjs
APP_HOST=hackspacelabs.com
AUTH_HOST=auth.hackspacelabs.com
AUTH_MODE=https
# APP_ORIGIN and AUTH_ORIGIN overrides are written by install.sh --lan-ip / --https.
BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
AUTH_PORT=8089
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SLIPWAY_DB_PASSWORD=
SLIPWAY_SECRET_KEY=
# Fernet key (urlsafe base64 of 32 bytes). Encrypts Slipway's SSH keys and secrets at rest; back it up.
SLIPWAY_ENCRYPTION_KEY=
