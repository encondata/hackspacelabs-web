# Generate a private .env with: node scripts/init-env.mjs
APP_HOST=hackspacelabs.com
AUTH_HOST=auth.hackspacelabs.com
AUTH_MODE=https
# APP_ORIGIN and AUTH_ORIGIN overrides are written by install.sh --lan-ip / --https.
BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
AUTH_PORT=8089
# HSL Suite apps (deployment/suite-apps.json). Set an app's origin, e.g. https://slipway.hackspacelabs.com or
# http://192.168.1.10:8080 for Switchyard on the LAN, to have the installer register its sign-in client. Then run
# node scripts/app-env.mjs <app> /path/to/that/app/.env. Blank leaves that app's client untouched.
SLIPWAY_ORIGIN=
SWITCHYARD_ORIGIN=
HARBORMASTER_ORIGIN=
TIDELINE_ORIGIN=
# The gateway's direct address (not through the proxy), for Slipway's and Harbor Master's API token owner check,
# e.g. http://192.168.1.10:8088. Not needed in LAN mode, where the site's own address is the gateway.
PORTAL_INTERNAL_URL=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
