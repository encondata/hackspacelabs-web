# Generate a private .env with: node scripts/init-env.mjs
APP_HOST=hackspacelabs.com
AUTH_HOST=auth.hackspacelabs.com
BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
AUTH_PORT=8089
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Configure before inviting users or testing email/password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=accounts@hackspacelabs.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
