{
  "realm": "hackspacelabs",
  "displayName": "HackSpaceLabs",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginTheme": "hackspacelabs",
  "emailTheme": "keycloak",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(14) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "revokeRefreshToken": false,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "client": {
      "hackspacelabs-web": [
        {
          "name": "customer",
          "description": "Access to the sample customer portal"
        },
        {
          "name": "admin",
          "description": "Access to the sample admin and customer portals"
        }
      ],
      "slipway": [
        {
          "name": "admin",
          "description": "Slipway: full control, including users' tokens and audit"
        },
        {
          "name": "maintainer",
          "description": "Slipway: manage hosts, instances and deployments"
        },
        {
          "name": "developer",
          "description": "Slipway: sync repositories, operate instances and deploy"
        },
        {
          "name": "viewer",
          "description": "Slipway: read-only access"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "hackspacelabs-web",
      "name": "HackSpaceLabs website",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HSL_CLIENT_SECRET}",
      "rootUrl": "${HSL_APP_ORIGIN}",
      "baseUrl": "${HSL_APP_ORIGIN}/",
      "redirectUris": [
        "${HSL_APP_ORIGIN}/api/auth/callback"
      ],
      "webOrigins": [
        "${HSL_APP_ORIGIN}"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HSL_APP_ORIGIN}/login",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "HackSpaceLabs application roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "hackspacelabs-web",
            "claim.name": "hsl_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "Slipway audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "slipway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "Slipway roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "slipway",
            "claim.name": "slipway_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "slipway",
      "name": "Slipway",
      "description": "Deployment API behind the HackSpaceLabs gateway. Holds Slipway roles, accepts access tokens issued to hackspacelabs-web, and uses a read-only service account to check API-token owners.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "clientScopeMappings": {
    "hackspacelabs-web": [
      {
        "client": "hackspacelabs-web",
        "roles": [
          "customer",
          "admin"
        ]
      }
    ],
    "slipway": [
      {
        "client": "hackspacelabs-web",
        "roles": [
          "admin",
          "maintainer",
          "developer",
          "viewer"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": false,
      "credentials": [
        {
          "type": "password",
          "temporary": true,
          "credentialData": "{\"hashIterations\":210000,\"algorithm\":\"pbkdf2-sha512\",\"additionalParameters\":{}}",
          "secretData": "{\"value\":\"VQt4OKhEpbM7s1CDUeFIZRWE/GfdbHxecfI5yXX82z7H8RLVGBOJlTYordVuQWFR9i9QZoxi2TDTJEuDcnF66g==\",\"salt\":\"Ox35CsV0fWTX77PMl03GLg==\",\"additionalParameters\":{}}"
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ],
      "clientRoles": {
        "hackspacelabs-web": [
          "admin"
        ],
        "slipway": [
          "admin"
        ]
      }
    }
  ]
}
